{
  "name": "bv-nodepack-wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "wiki:dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build && node scripts/materialize-static-routes.mjs",
    "wiki:build": "npm run build",
    "generate:contracts": "python scripts/generate-node-contracts.py --output src/generated/node-contracts.json --assets src/generated/asset-manifest.json",
    "validate": "node scripts/validate-docs.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2",
    "typescript": "7.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
